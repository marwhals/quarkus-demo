
# Ignore macOS system files
.DS_Store

# Ignore Windows system files
Thumbs.db
desktop.ini

# Ignore log files and temporary files
*.log
*.tmp
*.swp
*.swo

# Ignore build directories
/build/
/dist/
/out/

# Ignore dependency directories
/node_modules/
/vendor/

# Ignore environment variable files
.env
.env.local
.env.*.local

# Ignore IDE/editor specific files
/.idea/
/*.iml
.vscode/
/*.code-workspace

# Ignore compiled source files and executables
*.class
*.dll
*.exe
*.o
*.so

# Ignore archives
*.zip
*.tar.gz
*.rar
*.7z